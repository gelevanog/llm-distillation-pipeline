# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Pipeline settings (models, sizes, filters, training) live in the YAML files under configs/.

# ---------------------------------------------------------------------------------------------
# Teacher API keys (only the provider named in your config is needed)
# ---------------------------------------------------------------------------------------------
# OpenRouter: one key for hundreds of models. configs/openrouter-free.yaml uses free (":free") models
# only and refuses anything else while teacher.require_free_models is true.
# OPENROUTER_API_KEY=sk-or-...
# Any OpenAI-compatible gateway works too (LiteLLM proxy, vLLM, a corporate gateway).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (provider: openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=

# Anthropic (provider: anthropic, e.g. model: claude-sonnet-5)
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------------------------
# Serving: POST /triage, dashboard and playground (`distillery serve` / Docker)
# ---------------------------------------------------------------------------------------------
# Pipeline config the service reads (teacher for fallback, student base model, router settings).
DISTILLERY_CONFIG=configs/demo.yaml
# Run directory whose reports the dashboard shows (default: the config's output_dir), e.g.
# results/openrouter-free-2026-10-05 for the committed real run.
# DISTILLERY_RUN_DIR=
# Student backend override: fake (keyword rules, no downloads) or hf (base model + LoRA adapter,
# needs the `train` extra). Default: the config's student.backend.
# STUDENT_BACKEND=
# LoRA adapter to serve (default: <run dir>/student/adapter).
# STUDENT_ADAPTER_PATH=
# Fall back to the teacher when the student is invalid or unsure (needs the teacher's API key).
ROUTER_TEACHER_ENABLED=true

LOG_LEVEL=INFO
# console (human-readable) or json (one JSON object per line)
LOG_FORMAT=console
